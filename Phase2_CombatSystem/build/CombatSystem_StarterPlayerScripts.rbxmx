		BackgroundColor3 = Color3.fromRGB(230, 220, 190), BackgroundTransparency = 0.55, BorderSizePixel = 0 })
end
local centreDot = frame({ Parent = star, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(4, 4), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.3,
	BorderSizePixel = 0, corner = UDim.new(1, 0) })

-- bow crosshair
local cross = frame({ Parent = gui, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(18, 18), BackgroundTransparency = 1, corner = UDim.new(1, 0),
	stroke = Color3.fromRGB(240, 230, 200), Visible = false })

-- toast
local toastLabel = frame({ class = "TextLabel", Parent = gui, AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.new(0.5, 0, 0.5, -90), Size = UDim2.fromOffset(500, 34), BackgroundTransparency = 1,
	Font = Enum.Font.Garamond, TextSize = 30, TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0.4,
	Text = "", TextTransparency = 1 })
local toastT = 0

-- target panel (top centre)
local targetPanel = frame({ Parent = gui, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 24),
	Size = UDim2.fromOffset(300, 44), BackgroundColor3 = Color3.fromRGB(30, 24, 18), BackgroundTransparency = 0.3,
	corner = UDim.new(0, 4), stroke = Color3.fromRGB(150, 120, 70), Visible = false })
local targetName = frame({ class = "TextLabel", Parent = targetPanel, Size = UDim2.new(1, 0, 0, 20),
	BackgroundTransparency = 1, Font = Enum.Font.Garamond, TextSize = 20, TextColor3 = Color3.fromRGB(235, 225, 200),
