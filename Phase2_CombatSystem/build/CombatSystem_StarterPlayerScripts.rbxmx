<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="LocalScript" referent="RBX0000002E"><Properties><string name="Name">CombatClient</string><ProtectedString name="Source"><![CDATA[--!nonstrict
--[[
	CombatClient: controls, camera, animation playback, HUD and effects.

	Sword  LMB attack (direction = last mouse flick, shown on the star)
	       F / MMB thrust,  RMB hold = block (tap just before a hit = perfect block)
	       RMB during your wind-up = feint
	Bow    hold LMB = nock + draw, release = shoot (aim with the crosshair), RMB = let down
	Q lock on/off, Tab next target, 1 sword, 2 bow, Shift sprint
	G spawn sparring partner, J toggle partner Spar/Passive, H help
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local Debris = game:GetService("Debris")

local Combat = ReplicatedStorage:WaitForChild("Combat")
local CharacterAnimator = require(Combat.CharacterAnimator)
local ArrowModel = require(Combat.ArrowModel)
local WeaponModels = require(Combat.WeaponModels)
local Config = require(Combat.Config)

local remotes = ReplicatedStorage:WaitForChild("CombatRemotes")
local Request = remotes:WaitForChild("Request")
local Notify = remotes:WaitForChild("Notify")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local fxFolder = Instance.new("Folder")
fxFolder.Name = "CombatClientFX"
fxFolder.Parent = workspace

local function now()
	return workspace:GetServerTimeNow()
end

---------------------------------------------------------------------------
-- animation driver: every combat rig in the world
---------------------------------------------------------------------------
local tracked = {} -- [Model] = { anim, arrow, beams }

local function setupBowString(entry)
	-- world-space attachments updated every frame: works for Motor6D and skinned rigs alike
	local function att(name)
		local a = Instance.new("Attachment")
		a.Name = name
		a.Parent = workspace.Terrain
		return a
	end
	local top, mid, bottom = att("BowStringTop"), att("BowStringMid"), att("BowStringBottom")
	local function beam(a0, a1)
		local b = Instance.new("Beam")
		b.Attachment0 = a0
		b.Attachment1 = a1
		b.Width0, b.Width1 = 0.03, 0.03
		b.FaceCamera = true
		b.Segments = 1
		b.Color = ColorSequence.new(Color3.fromRGB(214, 200, 166))
		b.Transparency = NumberSequence.new(0)
		b.LightInfluence = 1
		b.Parent = top
		return b
	end
	entry.beams = { beam(top, mid), beam(mid, bottom) }
	entry.stringAtt = { top = top, mid = mid, bottom = bottom }
end

local function track(model)
	if tracked[model] then
		return
	end
	local anim = CharacterAnimator.new(model)
	if not anim then
		return -- not fully streamed yet; the scan retries
	end
	local entry = { anim = anim, dead = false, weapons = {} }
	for _, w in { "Sword", "Bow" } do
		entry.weapons[w] = WeaponModels.new(w, anim.rig.scale)
	end
	tracked[model] = entry
	setupBowString(entry)
end

local function untrack(model)
	local e = tracked[model]
	if e then
		if e.arrow then
			e.arrow:Destroy()
		end
		if e.stringAtt then
			for _, a in e.stringAtt do
				a:Destroy()
			end
		end
		for _, w in e.weapons do
			w:Destroy()
		end
		tracked[model] = nil
	end
end

task.spawn(function()
	while true do
		for _, m in workspace:GetChildren() do
			if m:IsA("Model") and m:GetAttribute("CombatRig") and not tracked[m] then
				track(m)
			end
		end
		for m in tracked do
			if not m.Parent then
				untrack(m)
			end
		end
		task.wait(0.5)
	end
end)

local function updateWeapons(model, entry, visible)
	local current = model:GetAttribute("Weapon") or "Sword"
	for name, m in entry.weapons do
		local cf = visible and name == current and entry.anim.rig:weaponWorld(name)
		if cf then
			m:PivotTo(cf)
			if m.Parent ~= fxFolder then
				m.Parent = fxFolder
			end
		elseif m.Parent then
			m.Parent = nil
		end
	end
end

local function updateBowVisuals(model, entry)
	local anim = entry.anim
	local rig = anim.rig
	local isBow = model:GetAttribute("Weapon") == "Bow"
	if entry.beams then
		for _, b in entry.beams do
			b.Enabled = isBow
		end
	end
	local props = isBow and anim:bowProps() or nil
	local fingers = rig:pointWorld("RightFingers")
	local sa = entry.stringAtt
	if sa and isBow then
		local top, bottom = rig:pointWorld("BowUpperNock"), rig:pointWorld("BowLowerNock")
		local restPt = rig:pointWorld("BowStringRest")
		if top and bottom and restPt then
			sa.top.WorldPosition = top
			sa.bottom.WorldPosition = bottom
			sa.mid.WorldPosition = (props and props.held and fingers) or restPt
		end
	end
	if props and props.arrow > 0 and fingers then
		if not entry.arrow then
			entry.arrow = ArrowModel.new()
			entry.arrow.Parent = fxFolder
		end
		local cf
		if props.arrow == 2 then
			local nock = props.held and fingers or rig:pointWorld("BowStringRest")
			cf = CFrame.lookAt(nock, rig:pointWorld("BowArrowRest"))
		else
			local dir = anim.hrp.CFrame:VectorToWorldSpace(rig:mapVector(props.dir))
			cf = CFrame.lookAt(fingers, fingers + dir)
		end
		entry.arrow:PivotTo(cf)
	elseif entry.arrow then
		entry.arrow:Destroy()
		entry.arrow = nil
	end
end

RunService.PreSimulation:Connect(function(dt)
	local t = now()
	local camPos = camera.CFrame.Position
	for model, entry in tracked do
		local hum = entry.anim.humanoid
		if not model.Parent then
			continue
		end
		if hum and hum.Health <= 0 then
			if not entry.dead then
				entry.dead = true
				entry.anim.rig:reset()
				updateWeapons(model, entry, false)
				if entry.beams then
					for _, b in entry.beams do
						b.Enabled = false
					end
				end
				if entry.arrow then
					entry.arrow:Destroy()
					entry.arrow = nil
				end
			end
			continue
		end
		local root = entry.anim.hrp
		if model ~= player.Character and (root.Position - camPos).Magnitude > 300 then
			continue
		end
		local pose = entry.anim:update(dt, t)
		entry.anim.rig:apply(pose)
		updateWeapons(model, entry, true)
		updateBowVisuals(model, entry)
	end
end)

---------------------------------------------------------------------------
-- HUD
---------------------------------------------------------------------------
local gui = Instance.new("ScreenGui")
gui.Name = "CombatHUD"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild("PlayerGui")

local function frame(props)
	local f = Instance.new(props.class or "Frame")
	for k, v in props do
		if k ~= "class" and k ~= "children" and k ~= "corner" and k ~= "stroke" then
			f[k] = v
		end
	end
	if props.corner then
		local c = Instance.new("UICorner")
		c.CornerRadius = props.corner
		c.Parent = f
	end
	if props.stroke then
		local s = Instance.new("UIStroke")
		s.Color = props.stroke
		s.Thickness = 1
		s.Transparency = 0.2
		s.Parent = f
	end
	return f
end

-- bars (bottom centre, KCD style: thin, parchment frame)
local bars = frame({ Parent = gui, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -28),
	Size = UDim2.fromOffset(380, 30), BackgroundColor3 = Color3.fromRGB(30, 24, 18), BackgroundTransparency = 0.25,
	corner = UDim.new(0, 4), stroke = Color3.fromRGB(150, 120, 70) })
local function bar(y, color)
	local back = frame({ Parent = bars, Position = UDim2.fromOffset(8, y), Size = UDim2.new(1, -16, 0, 7),
		BackgroundColor3 = Color3.fromRGB(15, 12, 10), BorderSizePixel = 0, corner = UDim.new(0, 2) })
	local fill = frame({ Parent = back, Size = UDim2.fromScale(1, 1), BackgroundColor3 = color, BorderSizePixel = 0,
		corner = UDim.new(0, 2) })
	return fill
end
local healthFill = bar(6, Color3.fromRGB(176, 42, 36))
local staminaFill = bar(17, Color3.fromRGB(214, 176, 72))

-- direction star (centre)
local star = frame({ Parent = gui, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(120, 120), BackgroundTransparency = 1 })
local DIR_POS = {
	HighRight = Vector2.new(30, -30), HighLeft = Vector2.new(-30, -30),
	HorizontalRL = Vector2.new(42, 0), HorizontalLR = Vector2.new(-42, 0), Thrust = Vector2.new(0, 38),
}
local pips = {}
for name, p in DIR_POS do
