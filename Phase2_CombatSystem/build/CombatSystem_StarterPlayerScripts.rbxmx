---------------------------------------------------------------------------
-- local character helpers
---------------------------------------------------------------------------
local function myChar()
	local c = player.Character
	if c and c:GetAttribute("CombatRig") and c:FindFirstChild("HumanoidRootPart") then
		return c
	end
	return nil
end

local function myState()
	local c = myChar()
	return c and c:GetAttribute("State") or "Idle"
end

local function myWeapon()
	local c = myChar()
	return c and c:GetAttribute("Weapon") or "Sword"
end

---------------------------------------------------------------------------
-- lock-on
---------------------------------------------------------------------------
local lockTarget = nil

local function candidates()
	local c = myChar()
	if not c then
		return {}
	end
	local out = {}
	local mine = c.HumanoidRootPart.Position
	local look = camera.CFrame.LookVector
	for m in tracked do
		if m ~= c and m.Parent then
			local hum = m:FindFirstChildOfClass("Humanoid")
			local hrp = m:FindFirstChild("HumanoidRootPart")
			if hum and hum.Health > 0 and hrp then
				local to = hrp.Position - mine
				local d = to.Magnitude
				if d < 38 then
					local ang = math.deg(math.acos(math.clamp(Vector3.new(look.X, 0, look.Z).Unit:Dot(Vector3.new(to.X, 0, to.Z).Unit), -1, 1)))
					table.insert(out, { m = m, score = ang * 0.08 + d * 0.1, ang = ang })
				end
			end
		end
	end
	table.sort(out, function(a, b)
		return a.score < b.score
	end)
	return out
end

local function setLock(m)
	lockTarget = m
	if m and m:FindFirstChild("Head") then
		marker.Adornee = m.Head
		marker.Enabled = true
	else
		marker.Adornee = nil
		marker.Enabled = false
	end
end

---------------------------------------------------------------------------
-- camera + facing
---------------------------------------------------------------------------
local camYaw, camPitch = 0, math.rad(-12)
local camDist = 11
local camDistNow = 11
local camFov = 70
local selectedDir = "HighRight"
local flick = Vector2.zero
local helpVisible = true
local shake = 0
local aimHeld = 0

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function aimPoint()
	local vp = camera.ViewportSize
	local ray = camera:ViewportPointToRay(vp.X / 2, vp.Y / 2)
	local exclude = { fxFolder }
	if player.Character then
		table.insert(exclude, player.Character)
	end
	rayParams.FilterDescendantsInstances = exclude
	local res = workspace:Raycast(ray.Origin, ray.Direction * Config.Bow.MaxRange, rayParams)
	return res and res.Position or (ray.Origin + ray.Direction * Config.Bow.MaxRange)
end

local function angleWrap(a)
	return (a + math.pi) % (2 * math.pi) - math.pi
end

UserInputService.InputChanged:Connect(function(input, processed)
	if input.UserInputType == Enum.UserInputType.MouseWheel and not processed then
		camDist = math.clamp(camDist - input.Position.Z * 1.5, 6, 20)
	end
end)

local function classifyFlick(v: Vector2)
	-- screen space: +x right, +y down. Direction = the side the blow comes FROM.
	local a = math.deg(math.atan2(-v.Y, v.X))
	if a >= 25 and a < 90 then
		return "HighRight"
	elseif a >= 90 and a < 155 then
		return "HighLeft"
	elseif a >= -60 and a < 25 then
		return "HorizontalRL"
	elseif a >= 155 or a < -120 then
		return "HorizontalLR"
	end
	return "Thrust"
end

local errorLabel = Instance.new("TextLabel")
errorLabel.Name = "CombatError"
errorLabel.AnchorPoint = Vector2.new(0.5, 0)
errorLabel.Position = UDim2.new(0.5, 0, 0, 60)
errorLabel.Size = UDim2.fromOffset(760, 60)
errorLabel.BackgroundColor3 = Color3.fromRGB(60, 10, 10)
errorLabel.BackgroundTransparency = 0.2
errorLabel.TextColor3 = Color3.new(1, 1, 1)
errorLabel.TextWrapped = true
errorLabel.Font = Enum.Font.Gotham
errorLabel.TextSize = 14
errorLabel.Visible = false
errorLabel.Parent = gui.Parent:FindFirstChild("CombatErrorGui") or (function()
	local g = Instance.new("ScreenGui")
	g.Name = "CombatErrorGui"
	g.ResetOnSpawn = false
	g.Parent = player:WaitForChild("PlayerGui")
	return g
end)()

RunService:BindToRenderStep("CombatCamera", Enum.RenderPriority.Camera.Value + 1, function(dt)
	local pc = player.Character
	local err = pc and pc:GetAttribute("CombatError")
	errorLabel.Visible = err ~= nil
	if err then
		errorLabel.Text = "[Combat] Your character can't be animated: " .. string.sub(tostring(err), 1, 300)
	end
	local char = myChar()
	if char and not tracked[char] then
		char = nil -- not bound (yet): keep the default camera
	end
	if not char then
		-- not (yet) the combat rig: leave Roblox's default camera and mouse alone
		if camera.CameraType == Enum.CameraType.Scriptable then
			camera.CameraType = Enum.CameraType.Custom
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			UserInputService.MouseIconEnabled = true
		end
		gui.Enabled = false
		return
	end
	gui.Enabled = true
	UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
	UserInputService.MouseIconEnabled = false
	camera.CameraType = Enum.CameraType.Scriptable

	local delta = UserInputService:GetMouseDelta()
	-- attack direction from recent mouse movement
	flick = flick * math.exp(-dt / 0.12) + delta
	if flick.Magnitude > 14 then
		selectedDir = classifyFlick(flick)
	end

	local state = myState()
	local weapon = myWeapon()
	local drawing = state == "BowDraw" or state == "BowAim"

	-- lock-on validity
	if lockTarget then
		local hum = lockTarget:FindFirstChildOfClass("Humanoid")
		local hrp = lockTarget:FindFirstChild("HumanoidRootPart")
		if not lockTarget.Parent or not hum or hum.Health <= 0 or not hrp or not char
			or (hrp.Position - char.HumanoidRootPart.Position).Magnitude > 48 then
			setLock(nil)
		end
	end

	local sens = drawing and 0.12 or 0.25
	if not lockTarget then
		camYaw -= math.rad(delta.X * sens)
		camPitch = math.clamp(camPitch - math.rad(delta.Y * sens), math.rad(-70), math.rad(60))
	end

	if char then
		local hrp = char.HumanoidRootPart
		local hum = char:FindFirstChildOfClass("Humanoid")
		local focus = hrp.Position + Vector3.new(0, 2.3, 0)
		if lockTarget then
			local to = lockTarget.HumanoidRootPart.Position - hrp.Position
			local want = math.atan2(-to.X, -to.Z)
			camYaw += angleWrap(want - camYaw) * math.clamp(dt * 8, 0, 1)
			camPitch += (math.rad(-10) - camPitch) * math.clamp(dt * 4, 0, 1)
		end

		-- body facing: towards the lock target, else where the camera looks
		if hum and hum.Health > 0 then
			hum.AutoRotate = false
			local wantYaw = camYaw
			if lockTarget then
				local to = lockTarget.HumanoidRootPart.Position - hrp.Position
				wantYaw = math.atan2(-to.X, -to.Z)
			end
			local look = hrp.CFrame.LookVector
			local curYaw = math.atan2(-look.X, -look.Z)
			local maxRate = 720
			if state == "Windup" or state == "Active" then
				maxRate = Config.Sword.TurnRateDuringAttack
			elseif state == "Staggered" then
				maxRate = 60
			end
			local step = math.rad(maxRate) * dt
			local yaw = curYaw + math.clamp(angleWrap(wantYaw - curYaw), -step, step)
			hrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, yaw, 0)
		end

		-- over-the-shoulder camera, tighter while drawing the bow
		local wantDist = drawing and 5.5 or camDist
		camDistNow += (wantDist - camDistNow) * math.clamp(dt * 6, 0, 1)
		local shoulder = drawing and 2.0 or 1.4
		local rot = CFrame.Angles(0, camYaw, 0) * CFrame.Angles(camPitch, 0, 0)
		local desired = focus + rot:VectorToWorldSpace(Vector3.new(shoulder, 0.4, camDistNow))
		rayParams.FilterDescendantsInstances = { char, fxFolder }
		local res = workspace:Raycast(focus, desired - focus, rayParams)
		if res then
			desired = res.Position + (focus - desired).Unit * 0.4
		end
		local jitter = Vector3.zero
		if shake > 0 then
			shake = math.max(0, shake - dt * 3)
			jitter = Vector3.new(math.random() - 0.5, math.random() - 0.5, 0) * shake * 0.4
		end
		camera.CFrame = CFrame.new(desired) * rot + rot:VectorToWorldSpace(jitter)
		camFov += ((drawing and (state == "BowAim" and 50 or 60) or 70) - camFov) * math.clamp(dt * 5, 0, 1)
		camera.FieldOfView = camFov
	end

	-- HUD
	local c = char
	if c then
		local hum = c:FindFirstChildOfClass("Humanoid")
		healthFill.Size = UDim2.fromScale(math.clamp(hum.Health / hum.MaxHealth, 0, 1), 1)
		local sMax = c:GetAttribute("MaxStamina") or 100
		staminaFill.Size = UDim2.fromScale(math.clamp((c:GetAttribute("Stamina") or sMax) / sMax, 0, 1), 1)
	end
	star.Visible = weapon == "Sword"
	for name, pip in pips do
		local on = name == selectedDir
		pip.BackgroundTransparency = on and 0 or 0.6
		pip.BackgroundColor3 = on and Color3.fromRGB(240, 196, 80) or Color3.fromRGB(230, 220, 190)
		pip.Size = on and UDim2.fromOffset(13, 13) or UDim2.fromOffset(8, 8)
	end
	centreDot.Visible = weapon == "Sword"
	cross.Visible = weapon == "Bow"
	-- crosshair grows with the same spread model the server uses
	if state == "BowAim" then
		aimHeld += dt
	else
		aimHeld = 0
	end
	local crossSize = 30
	if state == "BowAim" then
		local spread = Config.Bow.BaseSpreadDeg + Config.Bow.SpreadGrowthPerSecond * aimHeld
		local st = c and c:GetAttribute("Stamina") or 100
		if st < 20 then
			spread += Config.Bow.LowStaminaSpreadDeg
		end
		spread = math.min(spread, Config.Bow.MaxSpreadDeg)
		local px = camera.ViewportSize.Y / (2 * math.tan(math.rad(camera.FieldOfView / 2)))
		crossSize = math.max(8, 2 * px * math.tan(math.rad(spread)))
	elseif state == "BowDraw" then
		crossSize = 40
	end
	cross.Size = UDim2.fromOffset(crossSize, crossSize)
	if toastT > 0 then
		toastT -= dt
		toastLabel.TextTransparency = math.clamp(1 - toastT / 0.5, 0, 1)
		toastLabel.TextStrokeTransparency = 0.4 + 0.6 * math.clamp(1 - toastT / 0.5, 0, 1)
	end
	if lockTarget then
		local hum = lockTarget:FindFirstChildOfClass("Humanoid")
		targetPanel.Visible = true
		targetName.Text = hum and hum.DisplayName ~= "" and hum.DisplayName or lockTarget.Name
		tHealth.Size = UDim2.fromScale(hum and math.clamp(hum.Health / hum.MaxHealth, 0, 1) or 0, 1)
		local sMax = lockTarget:GetAttribute("MaxStamina") or 100
		tStamina.Size = UDim2.fromScale(math.clamp((lockTarget:GetAttribute("Stamina") or sMax) / sMax, 0, 1), 1)
	else
		targetPanel.Visible = false
	end
	help.Visible = helpVisible
end)

---------------------------------------------------------------------------
-- input
---------------------------------------------------------------------------
local function send(action, arg)
	Request:FireServer(action, arg)
end

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	local weapon = myWeapon()
	local t = input.UserInputType
	local k = input.KeyCode
	if t == Enum.UserInputType.MouseButton1 then
		if weapon == "Sword" then
			send("Attack", selectedDir)
		else
			send("BowPress")
		end
	elseif t == Enum.UserInputType.MouseButton2 then
		if weapon == "Sword" then
			send("BlockStart")
		else
			send("BowCancel")
		end
	elseif t == Enum.UserInputType.MouseButton3 or k == Enum.KeyCode.F then
		if weapon == "Sword" then
			send("Attack", "Thrust")
		end
	elseif k == Enum.KeyCode.Q then
		if lockTarget then
			setLock(nil)
		else
			local c = candidates()
			setLock(c[1] and c[1].m or nil)
			if not c[1] then
				showToast("No target in range", Color3.fromRGB(200, 200, 200))
			end
		end
	elseif k == Enum.KeyCode.One then
		send("Weapon", "Sword")
	elseif k == Enum.KeyCode.Two then
		send("Weapon", "Bow")
	elseif k == Enum.KeyCode.LeftShift then
		send("Sprint", true)
	elseif k == Enum.KeyCode.G then
		send("SpawnDummy")
	elseif k == Enum.KeyCode.J then
		send("DummyMode")
	elseif k == Enum.KeyCode.H then
		helpVisible = not helpVisible
	end
end)

UserInputService.InputEnded:Connect(function(input)
	local weapon = myWeapon()
	local t = input.UserInputType
	if t == Enum.UserInputType.MouseButton1 then
		if weapon == "Bow" then
			send("BowRelease", aimPoint())
		end
	elseif t == Enum.UserInputType.MouseButton2 then
		if weapon == "Sword" then
			send("BlockEnd")
		end
	elseif input.KeyCode == Enum.KeyCode.LeftShift then
		send("Sprint", false)
	end
end)

-- Tab cycles lock targets (and is sunk so the player list doesn't open)
ContextActionService:BindActionAtPriority("CombatNextTarget", function(_, inputState)
	if inputState == Enum.UserInputState.Begin then
		local c = candidates()
		if #c > 0 then
			local idx = 1
			for i, e in c do
				if e.m == lockTarget then
					idx = i % #c + 1
				end
			end
			setLock(c[idx].m)
		end
	end
	return Enum.ContextActionResult.Sink
end, false, 3000, Enum.KeyCode.Tab)

---------------------------------------------------------------------------
-- effects
---------------------------------------------------------------------------
local SOUNDS = {
	Swing = { "rbxasset://sounds/swordslash.wav", 0.9, 1.1, 0.5 },
	Thrust = { "rbxasset://sounds/swordlunge.wav", 0.9, 1.1, 0.5 },
	Block = { "rbxasset://sounds/unsheath.wav", 1.5, 1.8, 0.7 },
	Perfect = { "rbxasset://sounds/unsheath.wav", 2.0, 2.2, 0.9 },
	GuardBreak = { "rbxasset://sounds/unsheath.wav", 0.7, 0.8, 0.9 },
	Switch = { "rbxasset://sounds/unsheath.wav", 1.0, 1.1, 0.5 },
	Hit = { "rbxasset://sounds/swordlunge.wav", 0.55, 0.65, 0.6 },
}

local function playAt(kind, pos)
	local s = SOUNDS[kind]
	if not s then
		return
	end
	local a = Instance.new("Attachment")
	a.WorldPosition = pos
	a.Parent = workspace.Terrain
	local snd = Instance.new("Sound")
	snd.SoundId = s[1]
	snd.PlaybackSpeed = s[2] + math.random() * (s[3] - s[2])
	snd.Volume = s[4]
	snd.RollOffMaxDistance = 120
	snd.Parent = a
	snd:Play()
	Debris:AddItem(a, 3)
end

local PARTICLES = {
	Hit = { Color3.fromRGB(120, 10, 10), 14, 0.14, 6, 0.5 },
	Block = { Color3.fromRGB(255, 210, 120), 16, 0.08, 14, 0.25 },
	Perfect = { Color3.fromRGB(255, 240, 170), 30, 0.1, 18, 0.3 },
	GuardBreak = { Color3.fromRGB(255, 160, 80), 26, 0.12, 16, 0.35 },
	ArrowImpact = { Color3.fromRGB(150, 130, 100), 10, 0.12, 5, 0.4 },
}

local function burst(kind, pos)
	local p = PARTICLES[kind]
	if not p then
		return
	end
	local a = Instance.new("Attachment")
	a.WorldPosition = pos
	a.Parent = workspace.Terrain
	local e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(p[1])
	e.Size = NumberSequence.new(p[3], 0)
	e.Speed = NumberRange.new(p[4] * 0.5, p[4])
	e.Lifetime = NumberRange.new(p[5] * 0.6, p[5])
	e.SpreadAngle = Vector2.new(180, 180)
	e.Acceleration = Vector3.new(0, -30, 0)
	e.LightEmission = kind == "Hit" and 0 or 0.8
	e.Drag = 3
	e.Rate = 0
	e.Parent = a
	e:Emit(p[2])
	Debris:AddItem(a, 1.5)
end

-- flying arrows (visual; the server owns the real projectile)
local flying = {}
Notify.OnClientEvent:Connect(function(kind, a, b, c, d)
	if kind == "Toast" then
		showToast(a, b)
	elseif kind == "FX" then
		local fxKind, pos = a, b
		if fxKind == "Swing" then
			playAt(c == "Thrust" and "Thrust" or "Swing", pos)
		else
			playAt(fxKind, pos)
			burst(fxKind, pos)
		end
		local mine = myChar()
		if mine and (fxKind == "Hit" or fxKind == "GuardBreak")
			and (mine.HumanoidRootPart.Position - pos).Magnitude < 3.5 then
			shake = 1
		end
	elseif kind == "ArrowFired" then
		local model = ArrowModel.new()
		model.Parent = fxFolder
		flying[a] = { model = model, p0 = b, v0 = c, g = d, t0 = os.clock() }
	elseif kind == "ArrowEnd" then
		local f = flying[a]
		if f then
			f.model:Destroy()
			flying[a] = nil
		end
	end
end)

RunService.RenderStepped:Connect(function()
	local t = os.clock()
	for id, f in flying do
		local dt = t - f.t0
		if dt > Config.Bow.ArrowLifetime then
			f.model:Destroy()
			flying[id] = nil
		else
			local g = Vector3.new(0, -f.g, 0)
			local pos = f.p0 + f.v0 * dt + g * (0.5 * dt * dt)
			local vel = f.v0 + g * dt
			f.model:PivotTo(CFrame.lookAt(pos, pos + vel))
		end
	end
end)

player.CharacterAdded:Connect(function()
	setLock(nil)
end)

print("[Combat] Client ready. Press H for controls.")
]]></ProtectedString></Properties></Item></roblox>